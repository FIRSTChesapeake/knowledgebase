# Copy to .env (git-ignored) and fill in. Read by scripts/set-github-variables.sh
# (see k8s-do/README.md). Holds no secrets. The namespace and every cluster
# setting live in the cluster's config repo, not here.

# Hostname the site is served on; pushed as the repo variable APP_DOMAIN,
# which the image build bakes into the site's links.
APP_DOMAIN=kb.firstchs.org
