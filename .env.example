# Copy to .env (git-ignored) and fill in. Read by scripts/upload-github-secrets.sh
# and scripts/rotate-deploy-token.sh (see k8s-do/README.md). Holds no secrets:
# the deploy token is minted by the rotate script and never written here.

# Hostname the site is served on; pushed as the repo variable APP_DOMAIN.
APP_DOMAIN=kb.firstchs.org

# Namespace the site runs in; pushed as the repo variable K8S_NAMESPACE.
K8S_NAMESPACE=kb

# Owner of the GitHub repo, lowercase. Rendered into the bootstrap manifests
# by hand (k8s-do/README.md); not pushed, the workflow derives it itself.
GHCR_OWNER=firstchesapeake

# Admin kubeconfig the rotate script mints the deploy token with. Empty means
# kubectl's default ($KUBECONFIG, else ~/.kube/config).
KB_ADMIN_KUBECONFIG=

# Context in that kubeconfig. Empty means its current context.
KB_ADMIN_CONTEXT=

# Lifetime asked for the deploy token, in hours; the API server may cap it.
KB_TOKEN_DURATION=2160h

# Only for uploading a kubeconfig built by hand: its path. Leave empty when
# using the rotate script, which uploads the one it builds.
KUBECONFIG_KB_FILE=
